<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.vitahabitoapp">

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Material3.DayNight.NoActionBar">

        <!-- Pantalla de inicio (Login) -->
        <activity
            android:name=".LoginActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>

        <!-- Registro -->
        <activity android:name=".RegisterActivity" android:exported="false" />

        <!-- Menú -->
        <activity android:name=".MenuActivity" android:exported="false" />

        <!-- Crear hábito -->
        <activity android:name=".HabitFormActivity" android:exported="false" />

        <!-- Lista -->
        <activity android:name=".HabitListActivity" android:exported="false" />

        <!-- Detalle -->
        <activity android:name=".HabitDetailActivity" android:exported="false" />

        <!-- Editar -->
        <activity android:name=".HabitEditActivity" android:exported="false" />

    </application>

</manifest>
